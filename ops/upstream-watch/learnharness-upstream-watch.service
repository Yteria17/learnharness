[Unit]
Description=Review LearnHarness upstream and integrate tested simple changes
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/learnharness-upstream-watch
ExecStart=/usr/bin/python3 %h/learnharness-upstream-watch/app/run.py --root %h/learnharness-upstream-watch
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GH_PROMPT_DISABLED=1
Environment=GIT_TERMINAL_PROMPT=0
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=2G
CPUQuota=150%
TasksMax=256
TimeoutStartSec=50min
KillMode=control-group

[Install]
WantedBy=default.target
